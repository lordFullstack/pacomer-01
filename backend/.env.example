# Supabase project
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
SUPABASE_ANON_KEY=CHANGE_ME

# Direct Postgres connection (used ONLY for the critical financial/transactional path,
# where we need real BEGIN/COMMIT control that supabase-js does not expose).
# Get this from Supabase > Project Settings > Database > Connection string (use the
# "Session" pooler or direct connection, not the transaction pooler, since we hold
# transactions open across multiple statements).
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.YOUR_PROJECT.supabase.co:5432/postgres

PORT=3000
NODE_ENV=development
